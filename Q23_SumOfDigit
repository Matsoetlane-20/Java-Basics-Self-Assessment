public class Q23_SumOfDigits {

    public static void main(String[] args) {

        int number = 700;
        int sum = 0;

        while (number > 0) {

            int digit = number % 10;
            sum = sum + digit;
            number = number / 10;
        }

        System.out.println("The sum of the digits is: " + sum);
    }
}
