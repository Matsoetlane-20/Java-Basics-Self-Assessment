public class Q11_SwapVariables {

    public static void main(String[] args) {

        int a = 15;
        int b = 27;

        System.out.println("Before swapping : a, b = " + a + ", " + b);

        int temp = a;
        a = b;
        b = temp;

        System.out.println("After swapping : a, b = " + a + ", " + b);
    }
}
